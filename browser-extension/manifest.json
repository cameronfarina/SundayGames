{
  "manifest_version": 3,
  "name": "Sunday Games ESPN Connector",
  "version": "0.1.0",
  "description": "Connect one private ESPN fantasy league to Sunday Games without copying cookies manually.",
  "permissions": ["cookies"],
  "host_permissions": ["https://fantasy.espn.com/*"],
  "background": {
    "service_worker": "src/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Sunday Games ESPN Connector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sundaygames.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["src/contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
